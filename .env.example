# ========================================
# AI Calling Platform - Environment Config
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Postgres Integration
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/aicalling
SECRET_KEY=GENERATE_A_NEW_SECRET_KEY_WITH_openssl_rand_hex_32
ALGORITHM=HS256

# LiveKit Integration
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud

# LLM Model Integration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ElevenLabs TTS
ELEVEN_API_KEY=YOUR_ELEVENLABS_API_KEY

# Deepgram STT
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY

# ========================================
# Observability
# ========================================
# Leave SENTRY_DSN empty to disable error tracking entirely (local dev / CI).
# Set it in staging/production to capture API + worker exceptions.
# PII (transcripts, phone numbers, emails, prompts) is scrubbed before send —
# see app/core/observability.py.
SENTRY_DSN=
ENVIRONMENT=development
# Fraction of requests traced for performance (0.0-1.0). Keep low in prod.
SENTRY_TRACES_SAMPLE_RATE=0.1

# LOG_FORMAT=json emits structured, queryable logs (use in deployed envs).
# Use 'text' locally for human-readable output.
LOG_FORMAT=text
LOG_LEVEL=INFO
