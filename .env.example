# ========================================
# AI Calling Platform - Environment Config
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Postgres Integration
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/aicalling
# Used by docker-compose to provision the local Postgres container.
DB_PASSWORD=YOUR_DB_PASSWORD

# ========================================
# Auth
# ========================================
SECRET_KEY=GENERATE_A_NEW_SECRET_KEY_WITH_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# REQUIRED — the app REFUSES TO START without this. app/core/config.py rejects
# both the placeholder default and anything under 32 chars.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=GENERATE_ME_python_-c_import_secrets_print_secrets_token_hex_32

# Self-serve registration. Leave FALSE in every deployed environment: access is
# granted by issuing credentials, and an open /auth/signup lets anyone register
# and spend your Twilio/LLM budget. Provision accounts instead with:
#   cd backend && python scripts/create_user.py --name "Acme" --email ops@acme.com
# Set true only for local development.
ALLOW_PUBLIC_SIGNUP=false

# ========================================
# App URLs
# ========================================
# Public HTTPS URL Twilio calls back on. localhost will NOT work for webhooks —
# run ngrok and paste the public URL here.
BASE_URL=http://localhost:8000
# Comma-separated CORS allowlist (the frontend origin).
ALLOWED_ORIGINS=http://localhost:3000

# ========================================
# Redis (arq job queue + campaign control flags)
# ========================================
REDIS_URL=redis://localhost:6379

# LiveKit Integration
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
# LiveKit Console -> SIP -> Trunks. Leave empty to fall back to a static
# greeting instead of bridging the caller to the AI agent.
LIVEKIT_SIP_DOMAIN=

# ========================================
# Twilio Voice (outbound calling)
# ========================================
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+15551234567

# LLM Model Integration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ElevenLabs TTS
ELEVEN_API_KEY=YOUR_ELEVENLABS_API_KEY

# Deepgram STT
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY

# ========================================
# Observability
# ========================================
# Leave SENTRY_DSN empty to disable error tracking entirely (local dev / CI).
# Set it in staging/production to capture API + worker exceptions.
# PII (transcripts, phone numbers, emails, prompts) is scrubbed before send —
# see app/core/observability.py.
SENTRY_DSN=
ENVIRONMENT=development
# Fraction of requests traced for performance (0.0-1.0). Keep low in prod.
SENTRY_TRACES_SAMPLE_RATE=0.1

# LOG_FORMAT=json emits structured, queryable logs (use in deployed envs).
# Use 'text' locally for human-readable output.
LOG_FORMAT=text
LOG_LEVEL=INFO
